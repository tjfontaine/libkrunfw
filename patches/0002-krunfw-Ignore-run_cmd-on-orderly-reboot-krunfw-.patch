From f4c3afd4c8a2e6ac276e34072030e396df907160 Mon Sep 17 00:00:00 2001
From: Sergio Lopez <slp@redhat.com>
Date: Mon, 16 May 2022 16:04:27 +0200
Subject: [PATCH 02/28] 0002-krunfw-Ignore-run_cmd-on-orderly-reboot: krunfw:
 Ignore run_cmd on orderly reboot

---
 kernel/reboot.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/kernel/reboot.c b/kernel/reboot.c
index f6947c5bd671..5925d8fcfbfa 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -853,7 +853,11 @@ static int __orderly_reboot(void)
 {
 	int ret;
 
+#ifdef VERBOSE_LIBKRUN
 	ret = run_cmd(reboot_cmd);
+#else
+	ret = 1;
+#endif
 
 	if (ret) {
 		pr_warn("Failed to start orderly reboot: forcing the issue\n");
-- 
