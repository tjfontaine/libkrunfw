+#define BIFROST_STR_MAX 256
+__bpf_kfunc u64 bifrost_kfunc_strlen(const char *uaddr)
+{
+	char buf[BIFROST_STR_MAX];
+	long n;
+
+	if (!uaddr)
+		return 0;
+	n = strncpy_from_user(buf, (const char __user *)uaddr,
+			       BIFROST_STR_MAX);
+	if (n < 0)
+		return 0;
+	if (n == BIFROST_STR_MAX)
+		n = BIFROST_STR_MAX - 1;
+	return (u64)n;
+}
