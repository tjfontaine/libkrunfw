+/// kernel-version-specific values.  Forward-looking; today's libkrun
+/// does NOT advertise this — Phase N.1 lays the codec, Phase N.2
+/// wires the patcher.
+pub const FEATURE_BTF_FIELD_RELOC: u64 = 1 << 33;
