+    | FEATURE_EXTENSIBLE_RECORDS
+    | FEATURE_LOADPROG_STATUS
+    | FEATURE_SELF_TRACE_EMIT
+    | FEATURE_USDT
+    | FEATURE_FBT
+    | FEATURE_RAWTP
